# 운영 .env.config — 서버의 backend(blue/green) 가 읽는다
# 원본은 Jenkins Secret file credential `itda-env-config`. 서버 파일을 직접 고치면 다음 배포에 덮인다.
# 변경 절차: docs/infra/README.md 3.5절 (credential 교체 → 현재 태그로 재배포)
# 키 목록의 원본: deploy/.env.config.example (docs/infra/deploy.md 6.2.1)

REGISTRY_PREFIX=                        # 빈 값 = 호스트 Docker 이미지 저장소

SPRING_PROFILES_ACTIVE=prod             # 빠지면 local 로 떠서 실패
AI_BASE_URL=http://host.docker.internal:9100/api/v1

DB_URL=jdbc:mariadb://<host>:<port>/itda?connectionTimeZone=UTC
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=redis                        # compose 서비스 이름 (itda-redis)
REDIS_PORT=6379
AUTH_REDIS_KEY_PREFIX=prod              # 프로필과 다르면 기동 실패
AUTH_JWT_ISSUER=itda-backend-prod       # 프로필과 다르면 기동 실패

# 운영용으로 새로 생성 (Base64URL 256비트 이상). kid 는 세 링 통틀어 유일
AUTH_ACCESS_ACTIVE_KID=
AUTH_ACCESS_ACTIVE_KEY=
AUTH_ACCESS_RETIRED_KEYS=
AUTH_REFRESH_ACTIVE_KID=
AUTH_REFRESH_ACTIVE_KEY=
AUTH_REFRESH_RETIRED_KEYS=
AUTH_ACTION_ACTIVE_KID=
AUTH_ACTION_ACTIVE_KEY=
AUTH_ACTION_RETIRED_KEYS=

MAIL_DISPATCH_ENABLED=true
MAIL_SMTP_HOST=smtp.naver.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=SSL
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=
# MAIL_REPLY_TO=
MAIL_LINK_EMAIL_VERIFICATION_URL=https://i-eum.site/auth/verify-email
MAIL_LINK_PASSWORD_RESET_URL=https://i-eum.site/auth/reset-password

LIVEKIT_URL=https://openvidu.i-eum.site
LIVEKIT_API_KEY=                        # /opt/openvidu/config/openvidu.env 의 같은 이름 값
LIVEKIT_API_SECRET=

CARTESIA_API_KEY=                       # 선택

# .env.tags (deploy.sh 전용 — 사람이 편집하지 않는다)
# WEB_TAG= / BACKEND_TAG= / AI_TAG=
