# AI 서비스 (apps/ai) — pydantic-settings, 접두사 ITDA_, 파일 apps/ai/.env (git 제외)
# 전부 기본값이 있어 비워 두어도 뜬다.

ITDA_DEBUG=true                         # 운영 false
ITDA_APP_NAME=itda-ai
ITDA_API_PREFIX=/api/v1
ITDA_ENGINE_VERSION=kbraille-2024-r18-v1   # 규칙 점역기(한글 점자 규정 제1~18항) 버전 표기
ITDA_RULE_VERSION=KBR-2024.1
