# 학습자 앱 (front/apps/mobile) — EXPO_PUBLIC_* 값은 빌드 시 번들에 그대로 들어간다(사용자가 꺼내 볼 수 있음)
# 개발:   front/apps/mobile/.env            (expo start / 디버그 빌드)
# 릴리스: front/apps/mobile/.env.production (release-app.sh · assembleRelease)
# 둘 다 git 제외. 서버 비밀값·Cartesia 키는 릴리스 번들에 넣지 않는다.

# ---------- .env (개발) ----------
# 실기기 USB:  adb reverse tcp:8080 tcp:8080 후 localhost
# 실기기 Wi-Fi: PC LAN IP (예: http://192.168.0.2:8080/api/v1)
# 에뮬레이터:  http://10.0.2.2:8080/api/v1 (미설정 시 코드 기본값)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# 개발 편의용. 릴리스에서는 backend 가 Cartesia 를 대신 호출하므로 넣지 않는다
EXPO_PUBLIC_CARTESIA_API_KEY=

# ---------- .env.production (릴리스) ----------
# EXPO_PUBLIC_API_URL=https://i-eum.site/api/v1
# EXPO_PUBLIC_APP_RELEASE_URL=https://i-eum.site/app      # 새 버전 알림·다운로드 페이지

# ---------- ~/.gradle/gradle.properties (릴리스 담당자 PC, 저장소 밖) ----------
# IEUM_UPLOAD_STORE_FILE=C:/Users/<me>/keys/ieum-upload.jks
# IEUM_UPLOAD_KEY_ALIAS=ieum-upload
# IEUM_UPLOAD_STORE_PASSWORD=
# IEUM_UPLOAD_KEY_PASSWORD=
# ieum.ninja=C:/Users/<me>/miniconda3/Scripts/ninja.exe   # 윈도우 260자 경로 우회 (docs/solutions 참고)
