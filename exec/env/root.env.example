# 루트 .env — 로컬 개발 (docker-compose.yml 의 backend·db 가 읽는다)
# 복사: cp exec/env/root.env.example .env   (저장소 루트, git 제외)
# 실제 값은 저장소에 두지 않는다. 형식·필수 여부는 exec/01-build-and-deploy.md 1.4절.

# ---- 프로필 ----
SPRING_PROFILES_ACTIVE=local            # local | prod

# ---- DB (compose db 서비스 초기화 + backend 접속) ----
DB_NAME=itda
DB_USERNAME=itda
DB_PASSWORD=                            # 필수. 볼륨을 처음 만들 때 저장되므로 이후 바꾸면 볼륨 재생성 필요
# 외부 DB(팀 공용·운영)를 쓸 때는 compose 오버라이드에서 DB_HOST/DB_PORT 를 덮는다 (compose 기본은 DB_HOST=db)

# ---- Redis / 인증 ----
AUTH_REDIS_KEY_PREFIX=local             # 프로필과 일치해야 기동 (local | prod)
AUTH_JWT_ISSUER=itda-backend-local

# 서명키: Base64URL 32바이트 이상. 생성: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# kid 는 access/refresh/action 세 링을 통틀어 유일해야 한다.
AUTH_ACCESS_ACTIVE_KID=access-local-1
AUTH_ACCESS_ACTIVE_KEY=
AUTH_ACCESS_RETIRED_KEYS=               # 선택. kid:key,kid:key
AUTH_REFRESH_ACTIVE_KID=refresh-local-1
AUTH_REFRESH_ACTIVE_KEY=
AUTH_REFRESH_RETIRED_KEYS=
AUTH_ACTION_ACTIVE_KID=action-local-1   # 이메일 인증·비밀번호 재설정 토큰
AUTH_ACTION_ACTIVE_KEY=
AUTH_ACTION_RETIRED_KEYS=

# ---- 실시간 음성 (OpenVidu/LiveKit) ----
LIVEKIT_URL=https://openvidu.i-eum.site # https 로. 앱용 wss 는 코드가 변환
LIVEKIT_API_KEY=                        # /opt/openvidu/config/openvidu.env 의 값
LIVEKIT_API_SECRET=

# ---- 메일 (가입 인증·비밀번호 재설정) ----
MAIL_DISPATCH_ENABLED=false             # false 면 발송 없음(outbox 에 기록만). 켜면 아래 전부 유효해야 기동
MAIL_SMTP_HOST=smtp.naver.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=SSL                  # SSL | STARTTLS | PLAINTEXT
MAIL_SMTP_USERNAME=                     # SSL/STARTTLS 면 필수 (네이버 앱 비밀번호)
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@i-eum.site
# MAIL_FROM_NAME=                       # 줄을 빼면 기본 "이음(I:EUM)". 값을 비워 두면 이름 없이 나감
# MAIL_REPLY_TO=
MAIL_LINK_EMAIL_VERIFICATION_URL=http://localhost:5173/auth/verify-email   # 절대 URL, http 는 루프백만
MAIL_LINK_PASSWORD_RESET_URL=http://localhost:5173/auth/reset-password

# ---- AI ----
# AI_BASE_URL 은 compose 가 http://ai:8000/api/v1 로 주입. 호스트에서 bootRun 하면 http://localhost:8000/api/v1

# ---- 음성 합성 ----
CARTESIA_API_KEY=                       # 선택. 비우면 목소리 API 만 503
