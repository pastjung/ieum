# 학습자 앱(@ieum/mobile) 환경변수 예시 — 실제 값은 .env에 두고 커밋하지 않는다.
# Expo CLI는 `expo start`를 실행하는 프로젝트 루트(= 이 디렉터리)의 .env를 읽는다.
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 들어가 사용자가 꺼내 볼 수 있다.
# 서버 비밀값(DB 비밀번호, 서명 키 등)은 여기에 두지 않는다.

# 백엔드 API base URL (context-path /api/v1까지 포함)
#
# Android 에뮬레이터: host PC의 localhost가 10.0.2.2다 (미설정 시 코드 기본값)
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
# iOS 시뮬레이터:
#   EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# 실기기(USB): adb reverse tcp:8080 tcp:8080 후 localhost를 쓴다
#   EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# 실기기(Wi-Fi): 개발 PC의 LAN IP를 쓴다
#   EXPO_PUBLIC_API_URL=http://192.168.0.2:8080/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Cartesia — 내 목소리 복제/합성 (설정 > 내 목소리로 답하기)
# https://play.cartesia.ai 에서 발급. 없으면 잇다는 시스템 TTS로 안내한다.
# 새 버전 확인·설치 페이지 주소. 비우면 확인하지 않는다 (운영: https://i-eum.site/app)
EXPO_PUBLIC_APP_RELEASE_URL=
