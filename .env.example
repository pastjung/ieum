# ==========================================================================
# 로컬 개발용 환경변수 (.env) 템플릿
#
# 사용법:  cp .env.example .env   → 필요한 값 채우기
#   - docker compose는 이 파일 옆의 .env를 자동으로 읽는다 (옵션 불필요)
#   - .env는 .gitignore로 차단되어 커밋되지 않는다 — 개인 비밀값은 .env에만
#   - 팀 공유가 필요한 비밀값은 Git이 아니라 팀 비공개 노션에서 공유한다
#
# 새 변수를 추가하는 방법:
#   이 파일에 변수와 설명 추가 → 각자 .env에 값 채우기. 그걸로 끝 —
#   compose의 env_file 설정이 .env를 모든 서비스 컨테이너에 자동 주입한다.
#   (compose의 environment에 직접 적힌 팀 공유 값이 항상 우선하므로,
#    .env로 프로필·내부 주소 같은 공유 설정을 덮어쓸 수는 없다)
#
# 참고: 운영 서버의 설정은 이 파일과 무관하다 — Jenkins Secret file
#       'itda-env-config'가 원본이며 배포 파이프라인이 반영한다 (docs/infra/README.md 3.5절)
# ==========================================================================

# ── backend DB ──────────────────────────────────────────────────────────
# 기본은 compose가 띄우는 MariaDB 11.8.9 컨테이너(프로필 local)다.
#
# DB_PASSWORD는 **필수**다. 저장소에 자격증명을 남기지 않기 위해 docker-compose.yml과
# application.yml 어디에도 비밀번호 기본값을 두지 않았다. 값이 없으면 db 서비스가
# 기동 단계에서 바로 실패한다.
DB_PASSWORD=changeme

# 이름과 계정은 기본값(itda)이 있으므로 바꿀 때만 설정한다.
# 바꿀 때는 db 서비스와 backend가 같은 값을 보도록 여기서 함께 설정한다.
#DB_NAME=itda
#DB_USERNAME=itda

# 호스트에서 ./gradlew bootRun으로 직접 띄울 때만 필요하다.
# (compose로 띄우면 DB_HOST=db가 자동 주입되므로 설정하지 않는다)
#DB_HOST=localhost
#DB_PORT=3306

# RDS(MariaDB)를 쓰려면 prod 프로필로 바꾸고 접속 정보를 채운다 (값은 팀 비공개 노션 참고).
# prod는 ddl-auto=validate라서 스키마가 엔티티와 일치해야 기동한다.
#SPRING_PROFILES_ACTIVE=prod
#DB_URL=jdbc:mariadb://<RDS_엔드포인트>:3306/itda?connectionTimeZone=UTC
#DB_USERNAME=
#DB_PASSWORD=

# ── backend Redis (인증 토큰 상태 저장 — docs/product/erd.md 3.1.1) ────────
# 기본은 compose가 띄우는 Redis 8.2.9 컨테이너다.
# 호스트에서 ./gradlew bootRun으로 직접 띄울 때만 필요하다.
# (compose로 띄우면 REDIS_HOST=redis가 자동 주입되므로 설정하지 않는다)
#REDIS_HOST=localhost
#REDIS_PORT=6379

# ── backend Access Token 서명 (docs/product/api-spec.md 3.6.1) ─────────────
# Access JWT는 HS256으로 서명하며 Access 전용 key ring을 쓴다.
# **세 값은 필수다.** 기본값을 두면 그 key가 그대로 운영에 올라가므로 코드에 기본값이 없다.
# 값이 없거나 형식이 어긋나면 backend가 기동 단계에서 실패한다.
#
# key 만드는 법 (CSPRNG 256비트를 Base64URL로 인코딩. 실제 값은 각자 .env에만 둔다):
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
# AUTH_JWT_ISSUER는 배포 환경별 논리 이름이며 운영 도메인을 넣지 않는다.
# 현재 실행 프로필과 일치해야 한다 — local 프로필이면 itda-backend-local이다.
AUTH_JWT_ISSUER=itda-backend-local

# 현재 서명에 쓰는 key의 식별자. 영문·숫자와 '.', '_', '~', '-'만 쓰며 쉼표와 콜론은 쓸 수 없다.
AUTH_ACCESS_ACTIVE_KID=local-1

# 위 kid에 대응하는 Base64URL key. 디코딩 후 32바이트 이상이어야 한다.
AUTH_ACCESS_ACTIVE_KEY=

# 회전으로 물러난 key 목록(선택). 아직 수명이 남은 토큰을 검증할 때만 쓴다.
# 형식: kid1:base64url,kid2:base64url   (비워 두면 retired key 없음)
#AUTH_ACCESS_RETIRED_KEYS=

# 그 외 개인 비밀값(외부 API 키 등)이 생기면 여기에 추가한다.