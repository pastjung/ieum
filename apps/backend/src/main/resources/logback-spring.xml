<?xml version="1.0" encoding="UTF-8"?>

<!--
  Boot 기본 콘솔 설정(org/springframework/boot/logging/logback/console-appender.xml)과 같다.
  encoder만 SensitiveDataMaskingEncoder로 바꿔, 최종 출력에서 JDBC 접속 정보와 UNIQUE 위반 값을 가린다.
  pattern·threshold·charset은 Boot 속성(logging.pattern.*, logging.threshold.console, logging.charset.console)을 그대로 따른다.
  파일 appender나 구조화 로그를 추가하면 같은 encoder를 거치게 해야 한다.
-->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>${CONSOLE_LOG_THRESHOLD}</level>
		</filter>
		<encoder class="com.itda.global.config.SensitiveDataMaskingEncoder">
			<pattern>${CONSOLE_LOG_PATTERN}</pattern>
			<charset>${CONSOLE_LOG_CHARSET}</charset>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
	</root>
</configuration>
