# ==========================================================================
# 이 파일을 복사해 EC2의 deploy/.env로 사용한다. 실제 값은 Git에 커밋하지 않는다.
#   cp .env.example .env
# ==========================================================================

# 이미지 저장소 prefix
#  - 로컬 이미지 저장소 사용(현재): 빈 값
#  - 레지스트리 도입 시: "registry.example.com/team/" 처럼 끝에 / 포함
REGISTRY_PREFIX=

# 서비스별 현재 배포 이미지 태그 (scripts/deploy.sh가 배포 시 갱신)
WEB_TAG=
BACKEND_TAG=
AI_TAG=

# RDS (MySQL)
DB_URL=jdbc:mysql://<RDS_엔드포인트>:3306/itda?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=itda
DB_PASSWORD=

# Backend → AI 내부 호출 경로
# 호스트 Nginx의 내부 리스너(127.0.0.1:9100)를 거쳐 활성 색(blue/green)으로 라우팅된다
AI_BASE_URL=http://host.docker.internal:9100/api/v1
