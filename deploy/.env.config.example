# ==========================================================================
# 운영 설정 (.env.config) — 원본은 Jenkins Secret file credential 'itda-env-config'
#
# 이 파일은 배포 파이프라인의 Sync 스테이지가 매 배포마다 서버
# /home/ubuntu/app/.env.config 로 내려보낸다. 값을 바꾸려면 서버가 아니라
# Jenkins Credentials에서 itda-env-config 파일을 교체하고 재배포한다
# (docs/infra/README.md 3.5절). 실제 값은 Git에 커밋하지 않는다.
# ==========================================================================

# 이미지 저장소 prefix
#  - 로컬 이미지 저장소 사용(현재): 빈 값
#  - 레지스트리 도입 시: "registry.example.com/team/" 처럼 끝에 / 포함
REGISTRY_PREFIX=

# backend 프로필: RDS 연결 전 local(H2), 연결 후 prod
BACKEND_PROFILE=prod

# RDS (MySQL)
DB_URL=jdbc:mysql://<RDS_엔드포인트>:3306/itda?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=itda
DB_PASSWORD=

# Backend → AI 내부 호출 경로
# 호스트 Nginx의 내부 리스너(127.0.0.1:9100)를 거쳐 활성 색(blue/green)으로 라우팅된다
AI_BASE_URL=http://host.docker.internal:9100/api/v1
